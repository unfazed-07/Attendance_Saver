# Azure SQL Database (ODBC Driver 18 for SQL Server must be installed on the host)
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=AttendanceSaverDB
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Azure Blob Storage (required for uploaded files)
AZURE_STORAGE_CONNECTION_STRING=

# Required to extract student attendance screenshots. If unset, use the editable verification table.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Generate a random secret (at least 32 characters) for prototype session tokens.
OTP_SIGNING_SECRET=
